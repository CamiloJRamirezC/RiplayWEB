+++ b/modules/environment/src/main/kotlin/it/fast4x/environment/utils/AudioStreamDownloader.kt
@@ -0,0 +1,123 @@
+package it.fast4x.environment.utils
+
+import it.fast4x.environment.Environment
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import org.schabi.newpipe.extractor.MediaFormat
+import org.schabi.newpipe.extractor.ServiceList
+import org.schabi.newpipe.extractor.stream.AudioStream
+import org.schabi.newpipe.extractor.stream.DeliveryMethod
+import org.schabi.newpipe.extractor.stream.StreamInfo
+import java.io.IOException
+import java.io.OutputStream
+import java.util.concurrent.TimeUnit
+
+/**
+ * Resolves the audio stream of a video with NewPipe Extractor and writes it to an OutputStream.
+ * Pure JVM: storing the file (MediaStore, tags, etc.) is done in the app module.
+ */
+object AudioStreamDownloader {
+
+    data class AudioTrack(
+        val url: String,
+        val mimeType: String,
+        val extension: String,
+        val bitrate: Int,
+    )
+
+    // YouTube throttles single large requests; downloading in Range chunks keeps full speed.
+    private const val CHUNK_SIZE = 1L * 1024 * 1024
+
+    private val client by lazy {
+        OkHttpClient.Builder()
+            .proxy(Environment.proxy)
+            .connectTimeout(20, TimeUnit.SECONDS)
+            .readTimeout(30, TimeUnit.SECONDS)
+            .build()
+    }
+
+    /**
+     * Picks the best progressive audio stream. Prefers M4A (AAC) because Android's MediaStore
+     * indexes it as music on every version; falls back to WebM/Opus.
+     */
+    fun resolveBestAudio(videoId: String): Result<AudioTrack> = runCatching {
+        NewPipeUtils.ensureInitialized()
+
+        val info = StreamInfo.getInfo(
+            ServiceList.YouTube,
+            "https://www.youtube.com/watch?v=$videoId"
+        )
+
+        val candidates: List<AudioStream> = info.audioStreams.filter {
+            it.isUrl && it.deliveryMethod == DeliveryMethod.PROGRESSIVE_HTTP && it.format != null
+        }
+        if (candidates.isEmpty()) throw IOException("No downloadable audio stream for $videoId")
+
+        val best = candidates.filter { it.format == MediaFormat.M4A }
+            .maxByOrNull { it.averageBitrate }
+            ?: candidates.maxBy { it.averageBitrate }
+
+        val format = best.format!!
+        AudioTrack(
+            url = best.content,
+            mimeType = format.mimeType,
+            extension = format.suffix,
+            bitrate = best.averageBitrate,
+        )
+    }
+
+    /**
+     * Downloads [track] into [output] using Range requests.
+     * [onProgress] receives (downloadedBytes, totalBytes or -1 if unknown).
+     * Check [isCancelled] to abort; the caller closes [output].
+     */
+    fun download(
+        track: AudioTrack,
+        output: OutputStream,
+        isCancelled: () -> Boolean = { false },
+        onProgress: (Long, Long) -> Unit = { _, _ -> },
+    ) {
+        var downloaded = 0L
+        var total = -1L
+        val buffer = ByteArray(64 * 1024)
+
+        while (total < 0 || downloaded < total) {
+            if (isCancelled()) throw IOException("Download cancelled")
+
+            val end = downloaded + CHUNK_SIZE - 1
+            val request = Request.Builder()
+                .url(track.url)
+                .header("Range", "bytes=$downloaded-$end")
+                .build()
+
+            client.newCall(request).execute().use { response ->
+                if (response.code == 416) return // past the end: done
+                if (!response.isSuccessful) throw IOException("HTTP ${response.code}")
+
+                if (total < 0) {
+                    // "Content-Range: bytes 0-1048575/4567890"
+                    total = response.header("Content-Range")
+                        ?.substringAfterLast('/')
+                        ?.toLongOrNull()
+                        ?: response.body.contentLength().takeIf { response.code == 200 } ?: -1L
+                }
+
+                var readInChunk = 0L
+                response.body.byteStream().use { input ->
+                    while (true) {
+                        if (isCancelled()) throw IOException("Download cancelled")
+                        val read = input.read(buffer)
+                        if (read == -1) break
+                        output.write(buffer, 0, read)
+                        downloaded += read
+                        readInChunk += read
+                        onProgress(downloaded, total)
+                    }
+                }
+
+                // Server ignored Range and sent the whole file, or returned an empty chunk.
+                if (response.code == 200 || readInChunk == 0L) return
+            }
+        }
+    }
+}
