+++ b/androidApp/src/main/kotlin/it/fast4x/riplay/utils/SongDownloadUtils.kt
@@ -0,0 +1,119 @@
+package it.fast4x.riplay.utils
+
+import android.content.ContentValues
+import android.content.Context
+import android.media.MediaScannerConnection
+import android.net.Uri
+import android.os.Environment as AndroidEnvironment
+import android.provider.MediaStore
+import androidx.media3.common.MediaItem
+import it.fast4x.environment.utils.AudioStreamDownloader
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.io.FileOutputStream
+
+private const val DOWNLOAD_FOLDER = "RiPlay"
+
+/**
+ * Downloads the audio of an online [mediaItem] and saves it as a local file in Music/RiPlay.
+ * The on-device library already observes MediaStore, so the song shows up there by itself.
+ */
+suspend fun Context.downloadSongToDevice(
+    mediaItem: MediaItem,
+    onProgress: (Int) -> Unit = {},
+): Result<Uri> = withContext(Dispatchers.IO) {
+    runCatching {
+        val track = AudioStreamDownloader.resolveBestAudio(mediaItem.mediaId).getOrThrow()
+
+        val title = mediaItem.mediaMetadata.title?.toString() ?: mediaItem.mediaId
+        val artist = mediaItem.mediaMetadata.artist?.toString()
+        val album = mediaItem.mediaMetadata.albumTitle?.toString()
+        val fileName = safeFileName(listOfNotNull(artist, title).joinToString(" - ")) +
+                ".${track.extension}"
+
+        var lastPercent = -1
+        val progress: (Long, Long) -> Unit = { done, total ->
+            if (total > 0) {
+                val percent = (done * 100 / total).toInt()
+                if (percent != lastPercent) { lastPercent = percent; onProgress(percent) }
+            }
+        }
+
+        if (isAtLeastAndroid10) {
+            saveWithMediaStore(fileName, title, artist, album, track, progress)
+        } else {
+            saveLegacy(fileName, track, progress)
+        }
+    }
+}
+
+private fun Context.saveWithMediaStore(
+    fileName: String,
+    title: String,
+    artist: String?,
+    album: String?,
+    track: AudioStreamDownloader.AudioTrack,
+    onProgress: (Long, Long) -> Unit,
+): Uri {
+    val resolver = contentResolver
+    val collection = MediaStore.Audio.Media.getContentUri(MediaStore.VOLUME_EXTERNAL_PRIMARY)
+
+    val values = ContentValues().apply {
+        put(MediaStore.Audio.Media.DISPLAY_NAME, fileName)
+        put(MediaStore.Audio.Media.MIME_TYPE, track.mimeType)
+        put(MediaStore.Audio.Media.RELATIVE_PATH, "${AndroidEnvironment.DIRECTORY_MUSIC}/$DOWNLOAD_FOLDER")
+        put(MediaStore.Audio.Media.TITLE, title)
+        artist?.let { put(MediaStore.Audio.Media.ARTIST, it) }
+        album?.let { put(MediaStore.Audio.Media.ALBUM, it) }
+        put(MediaStore.Audio.Media.IS_MUSIC, 1)
+        put(MediaStore.Audio.Media.IS_PENDING, 1) // hidden from other apps until finished
+    }
+
+    val uri = resolver.insert(collection, values)
+        ?: throw IllegalStateException("MediaStore insert failed")
+
+    try {
+        resolver.openOutputStream(uri)!!.use { out ->
+            AudioStreamDownloader.download(track, out, onProgress = onProgress)
+        }
+        resolver.update(
+            uri,
+            ContentValues().apply { put(MediaStore.Audio.Media.IS_PENDING, 0) },
+            null, null
+        )
+        return uri
+    } catch (e: Throwable) {
+        resolver.delete(uri, null, null) // don't leave half files behind
+        throw e
+    }
+}
+
+// Android 9 and lower: WRITE_EXTERNAL_STORAGE (already declared, maxSdk 32) must be granted.
+private fun Context.saveLegacy(
+    fileName: String,
+    track: AudioStreamDownloader.AudioTrack,
+    onProgress: (Long, Long) -> Unit,
+): Uri {
+    @Suppress("DEPRECATION")
+    val dir = File(
+        AndroidEnvironment.getExternalStoragePublicDirectory(AndroidEnvironment.DIRECTORY_MUSIC),
+        DOWNLOAD_FOLDER
+    ).apply { mkdirs() }
+    val file = File(dir, fileName)
+
+    try {
+        FileOutputStream(file).use { out ->
+            AudioStreamDownloader.download(track, out, onProgress = onProgress)
+        }
+    } catch (e: Throwable) {
+        file.delete()
+        throw e
+    }
+
+    MediaScannerConnection.scanFile(this, arrayOf(file.absolutePath), arrayOf(track.mimeType), null)
+    return Uri.fromFile(file)
+}
+
+private fun safeFileName(name: String): String =
+    name.replace(Regex("[\\\\/:*?\"<>|]"), "_").trim().take(120).ifBlank { "song" }
